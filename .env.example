# Leave everything blank to run Choreo HQ locally with just the demo.

# Sign in with Notion: from your public integration at https://www.notion.so/profile/integrations
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# The site's address. The redirect URI to register in Notion is APP_URL + /api/auth/callback
APP_URL=http://localhost:3457

# Postgres (Neon) for sign-ins. Vercel adds this when you connect a Neon database.
DATABASE_URL=

# 32 random bytes in base64, used to encrypt Notion tokens. Make one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
